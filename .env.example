# Copy to .env.local for local development, and add the same variables in
# Vercel > Project > Settings > Environment Variables. All are server-only:
# never prefix them with NEXT_PUBLIC_, and never commit real values.

# Appwrite Console > your project > Settings (or Overview) > API endpoint, e.g.
# https://fra.cloud.appwrite.io/v1 (the region part depends on your project)
APPWRITE_ENDPOINT=https://<region>.cloud.appwrite.io/v1

# Appwrite Console > your project > Settings > Project ID
APPWRITE_PROJECT_ID=your-project-id

# Appwrite Console > your project > Overview > API keys > Create API key (secret).
# The app needs the rows.read and rows.write scopes. The one-time setup script
# also needs databases, tables, columns and indexes (read + write).
APPWRITE_API_KEY=your-api-key

# Optional: only if you created the database or table under other ids.
# APPWRITE_DATABASE_ID=planner
# APPWRITE_TABLE_ID=planner_versions

# Private key every device must send to /api/planner. At least 24 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PLANNER_ACCESS_KEY=replace-with-a-long-random-key
