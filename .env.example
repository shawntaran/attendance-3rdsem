# Copy to .env.local for local development, and add the same variables on the host
# (Vercel > Project > Settings > Environment Variables, or Render > service >
# Environment). All are server-only: never prefix them with NEXT_PUBLIC_, and never
# commit real values.
#
# The same code runs on either database. Set ONE of the two blocks below on each
# host; each database keeps its own accounts and planners.

# ---- Required everywhere --------------------------------------------------------

# Signs the sign-in cookie. At least 32 characters; changing it signs everyone out.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-secret

# Optional: force a database when both blocks are set. Otherwise Supabase is used
# if configured, else Appwrite.
# DATABASE=supabase
# DATABASE=memory keeps accounts and planners in memory, for trying sign-in on your
# machine with no database. Development only; lost on restart.

# ---- Supabase (e.g. on Render) ----------------------------------------------------

# Supabase > Project Settings > Data API > Project URL
# SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase > Project Settings > API Keys > Secret keys (sb_secret_...). The legacy
# service_role key also works, as SUPABASE_SERVICE_ROLE_KEY.
# SUPABASE_SECRET_KEY=sb_secret_...

# ---- Appwrite (e.g. on Vercel) ----------------------------------------------------

# Appwrite Console > your project > Settings > API endpoint, e.g. https://fra.cloud.appwrite.io/v1
# APPWRITE_ENDPOINT=https://<region>.cloud.appwrite.io/v1
# APPWRITE_PROJECT_ID=your-project-id

# API key (secret). The app needs rows.read and rows.write. The one-time setup
# script also needs databases, tables, columns and indexes (read + write).
# APPWRITE_API_KEY=your-api-key

# Optional: only if you created the database or tables under other ids.
# APPWRITE_DATABASE_ID=planner
# APPWRITE_TABLE_ID=planner_versions
# APPWRITE_USERS_TABLE_ID=users
