# Copy to .env.local for local development, and add the same two variables in
# Vercel > Project > Settings > Environment Variables. Both are server-only:
# never prefix them with NEXT_PUBLIC_, and never commit real values.

# Supabase > Project Settings > API > Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase > Project Settings > API > service_role key (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
