# Copy to .env.local for local development, and add the same three variables in
# Vercel > Project > Settings > Environment Variables. All are server-only:
# never prefix them with NEXT_PUBLIC_, and never commit real values.

# Supabase > Project Settings > API > Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase > Project Settings > API > service_role key (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Private key every device must send to /api/planner. At least 24 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PLANNER_ACCESS_KEY=replace-with-a-long-random-key
